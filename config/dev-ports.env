# CodeFactoryV2 本地开发端口映射
#
# 启动脚本读取顺序：
# 1. 当前目录 .env.local 显式配置优先；
# 2. 若没有 .env.local，则按当前 git 分支读取本文件；
# 3. 若分支未登记，则回退到 main 默认端口。
#
# 命名规则：把分支名转换为大写，并将非字母数字字符替换为下划线。
# 例如 feat/p2-requirement-analysis-system -> FEAT_P2_REQUIREMENT_ANALYSIS_SYSTEM_API_PORT。

MAIN_API_PORT=8020
MAIN_WEB_PORT=5173
MAIN_DEFAULT_ROUTE=/documents

FEAT_P1_KNOWLEDGE_BASE_REVIEW_API_PORT=8021
FEAT_P1_KNOWLEDGE_BASE_REVIEW_WEB_PORT=5171
FEAT_P1_KNOWLEDGE_BASE_REVIEW_DEFAULT_ROUTE=/documents

FEAT_P2_REQUIREMENT_ANALYSIS_SYSTEM_API_PORT=8060
FEAT_P2_REQUIREMENT_ANALYSIS_SYSTEM_WEB_PORT=5183
FEAT_P2_REQUIREMENT_ANALYSIS_SYSTEM_DEFAULT_ROUTE=/requirements

FEAT_P3_SOFTWARE_DESIGN_SYSTEM_API_PORT=8030
FEAT_P3_SOFTWARE_DESIGN_SYSTEM_WEB_PORT=5174
FEAT_P3_SOFTWARE_DESIGN_SYSTEM_DEFAULT_ROUTE=/xx-p3

FEAT_P3_REQUIREMENT_TO_DESIGN_CONVERSION_API_PORT=8031
FEAT_P3_REQUIREMENT_TO_DESIGN_CONVERSION_WEB_PORT=5175
FEAT_P3_REQUIREMENT_TO_DESIGN_CONVERSION_DEFAULT_ROUTE=/p3-design-lab

FEAT_P4_TOOL_HUB_API_PORT=8010
FEAT_P4_TOOL_HUB_WEB_PORT=5180
FEAT_P4_TOOL_HUB_DEFAULT_ROUTE=/xx-p4

FEAT_P5_SOFTWARE_CONSTRUCTION_SYSTEM_API_PORT=8040
FEAT_P5_SOFTWARE_CONSTRUCTION_SYSTEM_WEB_PORT=5181
FEAT_P5_SOFTWARE_CONSTRUCTION_SYSTEM_DEFAULT_ROUTE=/build

FEAT_P6_PORTAL_PLATFORM_ENTRY_API_PORT=8050
FEAT_P6_PORTAL_PLATFORM_ENTRY_WEB_PORT=5182
FEAT_P6_PORTAL_PLATFORM_ENTRY_DEFAULT_ROUTE=/portal

FEAT_P_TEST_API_PORT=8070
FEAT_P_TEST_WEB_PORT=5190
FEAT_P_TEST_DEFAULT_ROUTE=/portal

FEAT_P_BASE_PLATFORM_API_PORT=8080
FEAT_P_BASE_PLATFORM_WEB_PORT=5191
FEAT_P_BASE_PLATFORM_DEFAULT_ROUTE=/portal

# P3 requirement-to-software-design Dify workflow.
# Keep CODEFACTORY_P3_DIFY_API_KEY out of git; load it from ~/.codefactory/dify.local.env or shell export.
CODEFACTORY_P3_DIFY_BASE_URL=http://localhost/v1
CODEFACTORY_P3_DIFY_WORKFLOW_ID=587ab682-81d2-40d4-b4ee-047849455b5f
CODEFACTORY_P3_DIFY_TIMEOUT_SECONDS=520

# P3 scoped software design edit Dify workflow.
# Keep CODEFACTORY_P3_SCOPED_DIFY_API_KEY out of git; load it from ~/.codefactory/dify.local.env or shell export.
CODEFACTORY_P3_SCOPED_DIFY_BASE_URL=http://localhost/v1
CODEFACTORY_P3_SCOPED_DIFY_WORKFLOW_ID=1b1d17a4-cb0f-4c9c-b59b-8d6ba76f22ff
CODEFACTORY_P3_SCOPED_DIFY_TIMEOUT_SECONDS=180
