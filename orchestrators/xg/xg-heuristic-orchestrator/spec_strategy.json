  "defaults": {
    "leaf_question_template": "组织器策略问题：请补齐{clause_title}。"
  },
  "clauses": {
    "REQ-1.1": {
      "question": "组织器策略问题：请先确认软件名称、背景领域和编写目的。"
    },
    "REQ-1.2": {
      "question": "组织器策略问题：请确认本文档适用的软件范围、第一阶段边界、主要用户和明确不纳入范围。"
    },
    "REQ-1.3": {
      "question": "组织器策略问题：请确认本文档需要定义哪些核心术语、缩略语或领域专有概念。"
    },
    "REQ-2.1": {
      "question": "组织器策略问题：请确认软件定位、领域边界、解决的问题，以及第一阶段明确不做的内容。"
    },
    "REQ-2.2": {
      "question": "组织器策略问题：请确认建设目标、预期价值和近期优先达成的效果。"
    },
    "REQ-2.3": {
      "question": "组织器策略问题：请描述主要使用场景、触发条件、使用频率和典型用户操作。"
    },
    "REQ-2.4": {
      "question": "组织器策略问题：请明确纳入范围、排除范围和仍有争议的边界。"
    },
    "REQ-3.1": {
      "question": "组织器策略问题：请说明主要用户角色、职责、协作者和管理员边界。"
    },
    "REQ-3.2": {
      "question": "组织器策略问题：请按用户从开始到得到结果的主线描述核心业务流程。"
    },
    "REQ-3.3": {
      "question": "组织器策略问题：请说明态势展示与浏览需要展示哪些对象、状态、图层和交互能力。"
    },
    "REQ-3.4": {
      "question": "组织器策略问题：请说明需要哪些空间分析工具，例如量算、坡度、地理查询或其他分析能力。"
    },
    "REQ-3.5": {
      "question": "组织器策略问题：请说明部署分析能力需要分析哪些部署对象、范围、约束和结果。"
    },
    "REQ-3.6": {
      "question": "组织器策略问题：请说明分析结果如何输出、保存、共享或形成报告。"
    },
    "REQ-3.7": {
      "question": "组织器策略问题：请说明失败、缺数据、冲突或人工复核时的异常与补偿处理。"
    },
    "REQ-4.1": {
      "question": "组织器策略问题：请确认输入数据来源、数据格式、导入方式和数据质量要求。"
    },
    "REQ-4.2": {
      "question": "组织器策略问题：请确认输出数据、报表、导出格式和结果留存要求。"
    },
    "REQ-4.3": {
      "question": "组织器策略问题：请确认是否需要外部接口，以及接口对象、方向和交换内容。"
    },
    "REQ-5.1": {
      "question": "组织器策略问题：请确认响应、批处理、稳定性和可靠性方面的非功能约束。"
    },
    "REQ-5.2": {
      "question": "组织器策略问题：请确认安全、权限、审计和数据访问控制要求。"
    },
    "REQ-5.3": {
      "question": "组织器策略问题：请确认部署形态、运行环境、网络环境和运维约束。"
    },
    "REQ-5.4": {
      "question": "组织器策略问题：请确认分析精度、数据质量、结果校核和质量约束。"
    },
    "REQ-6.1": {
      "question": "组织器策略问题：请说明哪些典型场景可以用于验收本软件。"
    },
    "REQ-6.2": {
      "question": "组织器策略问题：请说明怎样判断这份需求对应的软件已经可接受。"
    },
    "REQ-6.3": {
      "question": "组织器策略问题：请列出当前仍需后续确认的业务、技术或验收事项。"
    }
