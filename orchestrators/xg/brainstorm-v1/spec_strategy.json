  "defaults": {
    "leaf_question_template": "请补齐{clause_title}。"
  },
  "clauses": {
    "REQ-1.1": {
      "question": "请先确认软件名称、背景领域和编写目的。"
    },
    "REQ-1.2": {
      "question": "请确认本文档适用的软件范围、第一阶段边界、主要用户和明确不纳入范围。"
    },
    "REQ-1.3": {
      "question": "请确认本文档需要定义哪些核心术语、缩略语或领域专有概念。"
    },
    "REQ-2.1": {
      "question": "请确认软件定位、领域边界、解决的问题，以及第一阶段明确不做的内容。"
    },
    "REQ-2.2": {
      "question": "请确认建设目标、预期价值和近期优先达成的效果。"
    },
    "REQ-2.3": {
      "question": "请描述主要使用场景、触发条件、使用频率和典型用户操作。"
    },
    "REQ-2.4": {
      "question": "请明确纳入范围、排除范围和仍有争议的边界。"
    },
    "REQ-3.1": {
      "question": "请确认工程接口需求，包括外部系统、文件导入导出、内网数据加载、人工移交、接口方向、交换内容、失败处理和责任边界。"
    },
    "REQ-3.2": {
      "question": "请按需求功能模块拆分功能需求。每个功能模块应说明使用角色、输入、处理行为、输出、约束、异常和验收要点。"
    },
    "REQ-3.3": {
      "question": "请确认性能需求，包括地图浏览、查询、分析、导入导出、并发、刷新频率、长耗时任务和失败恢复指标。"
    },
    "REQ-3.4": {
      "question": "请确认安装和操作要求，包括安装对象、初始化配置、默认参数、启动关闭、升级备份、日志查看、操作手册和运维交接。"
    },
    "REQ-3.5": {
      "question": "请确认业务规则与异常补偿，包括状态流转、计算规则、人工确认边界、数据缺失、坐标系不一致、权限不足、计算失败、保存失败和导出失败处理。"
    },
    "REQ-4.1": {
      "question": "请确认硬件需求，包括服务器、客户端终端、存储、网络设备、显示设备、专用设备、备份介质和数据规模约束。"
    },
    "REQ-4.2": {
      "question": "请确认软件需求，包括操作系统、数据库、中间件、浏览器、GIS 引擎、地图服务、算法库、第三方授权和运维工具。"
    },
    "REQ-4.3": {
      "question": "请确认网络与部署环境，包括单机、内网、专网、离线、私有云、访问路径、安全隔离、升级备份和日志留存边界。"
    },
    "REQ-5.1": {
      "question": "请确认输入数据来源、数据格式、更新频率、坐标系、质量要求和异常数据处理。"
    },
    "REQ-5.2": {
      "question": "请确认输出数据与成果，包括专题图件、结果表、报告、任务记录、导出格式、输出对象、权限和归档要求。"
    },
    "REQ-5.3": {
      "question": "请确认数据质量与追溯要求，包括来源、时间、参数、处理过程、版本、审计、复核和适用限制。"
    },
    "REQ-6.1": {
      "question": "请确认安全与权限要求，包括身份认证、角色权限、数据访问控制、操作审计、成果导出控制、水印和敏感数据保护。"
    },
    "REQ-6.2": {
      "question": "请确认可靠性与可用性要求，包括故障提示、任务恢复、自动保存、失败重试、日志、告警、监控和运维诊断。"
    },
    "REQ-6.3": {
      "question": "请确认精度与质量约束，包括分析结果用途、精度等级、数据质量影响、辅助研判边界、复核机制和免责声明。"
    },
    "REQ-7.1": {
      "question": "请说明哪些典型场景可以用于验收本软件，要求覆盖工程需求、运行环境、数据质量、安全约束和异常场景。"
    },
    "REQ-7.2": {
      "question": "请说明怎样判断这份需求对应的软件已经可接受，包括功能、接口、性能、安装操作、运行环境、数据质量、安全权限和输出物准则。"
    },
    "REQ-7.3": {
      "question": "请列出当前仍需后续确认的业务、技术或验收事项。"
    }
  }
}
